{
  "name": "sarkari-global-result",
  "version": "1.0.0",
  "description": "Sarkari Global Result Backend",
  "main": "src/server.js",
  "scripts": {
    "build": "npm run check",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "check": "find src migrations -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "uuid": "^11.1.1"
  }
}
